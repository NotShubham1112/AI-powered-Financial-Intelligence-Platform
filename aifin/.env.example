# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-key-here

# Default chat: fast free-tier chain (google/gemini-flash:free → openrouter/free)
# See aifin/core/models/config.ts — Nemotron/70B+ blocked for live streaming

# Financial MCP server (local)
FINANCIAL_MCP_URL=http://127.0.0.1:8000

# Optional: public site URL for OpenRouter referer header
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Redis for response cache (falls back to in-memory)
# REDIS_URL=redis://127.0.0.1:6379
